workspace "misc" {
    open-on-output "eDP-1"
}

spawn-at-startup "QQ"

window-rule {
    match app-id="QQ"
    open-on-workspace "misc"
    default-window-height { proportion 0.80; }
}

spawn-at-startup "clash-verge"

window-rule {
    match app-id="clash-verge"
    open-on-workspace "misc"
    default-window-height { proportion 0.80; }
}

window-rule {
    match app-id="^musicfox$"
    open-on-workspace "misc"
}

window-rule {
    match app-id=r#"^md\.obsidian\.Obsidian$"#
    open-on-workspace "misc"

    default-column-width { proportion 0.8; }
}
